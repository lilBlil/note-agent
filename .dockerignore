# --- secrets: never bake into the image ---
.env
.env.*
!.env.example

# --- version control / CI ---
.git
.gitignore
.github

# --- python caches / build artifacts ---
__pycache__/
*.py[cod]
.venv/
.python-version
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- generated runtime outputs (mounted as volumes instead) ---
notes/
runs/
.cache/
.streamlit/secrets.toml

# --- eval/benchmark artifacts ---
tests/eval/benchmark_results/
tests/eval/snapshots/*.new.txt

# --- editor / OS cruft ---
.vscode/
.idea/
.DS_Store
*.log

# --- docs & local-only ---
demos/
PROJECT_LOGIC.md
